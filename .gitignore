.DS_Store

# Ignore target directories anywhere
**/target/
**/__pycache__

**/.env
**/.env.local
**/farf/tmp

.continue

# Ignore (most) vscode stuff
.vscode/*
.cursor/*
.zed/*
*.code-workspace

# Allow vscode recommended extensions
!.vscode/extensions.json

# Allow some cursor rules
!.cursor/rules/rust-guidelines.mdc

.idea

# Ignore direnv
.direnv

# Claude Code related stuff
**/.claude/settings.local.json

# Added by cargo
/target
**/test-ledger
**/test-ledger.run-*

# Local mise files
mise.local.toml
mise.local.lock

# Used by scripts/setup-worktree.sh to identify initialized workspaces.
.worktree-initialized
